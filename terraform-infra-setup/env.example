AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

PROJECT_NAME=mju-be
DEPLOY_ENV=dev
ECR_REPOSITORY=mju-be
API_STAGE=$default

LAMBDA_MEMORY_SIZE=512
LAMBDA_TIMEOUT=30
LOG_RETENTION_DAYS=14
DOCKERFILE_PATH=infra/bootstrap-image/Dockerfile
DOCKER_BUILD_CONTEXT=infra/bootstrap-image

# Optional Slack incoming webhook for success/failure notifications.
# Keep the real value in .env or your shell, not in source control.
SLACK_WEBHOOK_URL=

# Optional JSON map merged into Lambda environment variables.
# Avoid long-lived secrets here because Terraform state can store Lambda environment values.
LAMBDA_ENV_JSON={"LOG_LEVEL":"INFO"}
